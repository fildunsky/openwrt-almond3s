#!/usr/bin/env python3
# Шим uci для песочницы эмулятора: `uci [-q] get a.b.c` из JSON-базы стаба.
import json, sys
args = [a for a in sys.argv[1:] if a != "-q"]
if len(args) < 2 or args[0] != "get":
    sys.exit(1)
try:
    v = json.load(open("/tmp/almond3s-emu/uci.json"))
    for k in args[1].split("."):
        v = v[k]
    if isinstance(v, (dict, list)):
        sys.exit(1)
    print(v)
except Exception:
    sys.exit(1)
