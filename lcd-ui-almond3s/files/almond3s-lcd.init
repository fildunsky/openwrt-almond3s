#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

start_service() {
	[ -c /dev/lcd ] || return

	echo -n "touch_start" > /dev/lcd 2>/dev/null

	procd_open_instance render
	procd_set_param command /usr/libexec/almond3s/render
	procd_set_param respawn
	procd_close_instance

	procd_open_instance touch
	procd_set_param command /usr/bin/almond3s-lcd daemon_fg
	procd_set_param respawn
	procd_close_instance

	procd_open_instance collector
	procd_set_param command /usr/libexec/almond3s/collector
	procd_set_param respawn
	procd_close_instance

	procd_open_instance ui
	procd_set_param command /usr/bin/ucode /usr/libexec/almond3s/ui.uc
	procd_set_param respawn
	procd_set_param stderr 1
	procd_close_instance
}

# Подчищаем сирот ПОСЛЕ остановки, а не до: прежний stop_service сам убивал
# процессы, которыми ещё владел procd, - тот успевал их переспавнить в окне
# restart, и после start жило по два-три интерфейса разом (наперегонки
# рисовали экран, тянули события тача и однажды довели панель до белого
# экрана командным мусором посреди кадра). service_stopped выполняется,
# когда procd уже погасил своё, - здесь добиваем только настоящих сирот.
service_stopped() {
	sleep 1
	killall -9 render collector 2>/dev/null
	for _p in $(pgrep -f "ucode /usr/libexec/almond3s/ui.uc" 2>/dev/null); do
		kill -9 "$_p" 2>/dev/null
	done
}
