#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

start_service() {
	[ -c /dev/lcd ] || return

	echo -n "touch_start" > /dev/lcd 2>/dev/null

	procd_open_instance render
	procd_set_param command /usr/libexec/almond3s/render
	procd_set_param respawn
	procd_close_instance

	procd_open_instance touch
	procd_set_param command /usr/bin/almond3s-lcd daemon_fg
	procd_set_param respawn
	procd_close_instance

	procd_open_instance collector
	procd_set_param command /usr/libexec/almond3s/collector
	procd_set_param respawn
	procd_close_instance

	procd_open_instance ui
	procd_set_param command /usr/bin/ucode /usr/libexec/almond3s/ui.uc
	procd_set_param respawn
	procd_set_param stderr 1
	procd_close_instance
}

# Подчищаем за собой ЯВНО. Раньше здесь глушился только демон тача, а внутри
# start_service стояли sleep - и два перезапуска подряд (например, postinst
# пакета и ручной restart) успевали наплодить вторые копии: старый lcd_ui
# продолжал рисовать по старому коду, а старый сборщик данных - переписывать
# снимок, из-за чего правки «не применялись».
stop_service() {
	killall render collector almond3s-lcd 2>/dev/null
	for _p in $(pgrep -f "ucode /usr/libexec/almond3s/ui.uc" 2>/dev/null); do
		kill "$_p" 2>/dev/null
	done
}
