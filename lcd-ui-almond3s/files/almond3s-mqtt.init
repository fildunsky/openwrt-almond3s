#!/bin/sh /etc/rc.common
START=96
STOP=10
USE_PROCD=1

start_service() {
	local enabled host port node user pass prefix period control homed_prefix retain
	config_load almond3s
	config_get_bool enabled mqtt enabled 0
	config_get host mqtt host ""
	config_get port mqtt port 1883
	config_get node mqtt node ""
	config_get user mqtt user ""
	config_get pass mqtt pass ""
	config_get prefix mqtt prefix "almond3s"
	config_get period mqtt period 60
	# Управление: off - только отдаём метрики (как было), ha - выключатели и
	# кнопки для Home Assistant, homed - темы td/fd службы custom, both - оба.
	config_get control mqtt control "off"
	config_get homed_prefix mqtt homed_prefix "homed"
	# retain на теме состояния: подписчик видит последние метрики сразу при
	# подключении, не дожидаясь следующего цикла публикации.
	config_get_bool retain mqtt retain 0

	[ "$enabled" = "1" ] || return 0
	[ -n "$host" ] || return 0
	[ -n "$node" ] || node=$(uci -q get system.@system[0].hostname || echo almond)

	procd_open_instance
	procd_set_param command /usr/libexec/almond3s/almond3s-mqtt \
		"$host" "$port" "$node" "$user" "$pass" "$prefix" "$period" \
		"$control" "$homed_prefix" "$retain"
	procd_set_param respawn 30 10 0
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger almond3s
}
